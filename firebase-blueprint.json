{
  "entities": {
    "UserRoot": {
      "title": "User Root Document",
      "description": "Non-PII root ownership anchor for a verified CloudPrep user.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "Firebase Authentication UID matching the document ID."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp when user anchor was created."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp when user anchor was last touched."
        }
      },
      "required": ["uid", "createdAt", "updatedAt"]
    },
    "UserPrivateProfile": {
      "title": "User Private Profile",
      "description": "Isolated PII profile record strictly accessible only by the owning user.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "Firebase Authentication UID."
        },
        "email": {
          "type": "string",
          "format": "email",
          "minLength": 3,
          "maxLength": 254,
          "description": "Verified account email address."
        },
        "displayName": {
          "type": "string",
          "maxLength": 120,
          "description": "Display name from Google OAuth."
        },
        "photoUrl": {
          "type": "string",
          "maxLength": 500,
          "description": "Avatar URL from Google OAuth."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server creation timestamp."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server update timestamp."
        }
      },
      "required": ["uid", "email", "createdAt", "updatedAt"]
    },
    "UserStudyProgress": {
      "title": "User Study Progress",
      "description": "Persisted CLF-C02 services reviewed, labs solved, achievements claimed, SM-2 SRS state, and arcade stats.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "Owning Firebase Auth UID."
        },
        "reviewedServices": {
          "type": "array",
          "description": "Reviewed AWS service IDs (max 200)."
        },
        "completedScenarios": {
          "type": "array",
          "description": "Completed practice lab scenario IDs (max 100)."
        },
        "perfectScenarios": {
          "type": "array",
          "description": "First-try perfect practice lab scenario IDs (max 100)."
        },
        "claimedAchievements": {
          "type": "array",
          "description": "Claimed achievement badge IDs (max 50)."
        },
        "flashcardConfidence": {
          "type": "object",
          "description": "Map of flashcard ID to confidence level (review, familiar, mastered)."
        },
        "flashcardSrs": {
          "type": "object",
          "description": "Map of flashcard ID to SM-2 spaced repetition state."
        },
        "quizSrs": {
          "type": "object",
          "description": "Map of quiz question ID to SM-2 spaced repetition state."
        },
        "arcade": {
          "type": "object",
          "description": "Gamification XP, streak, daily goal, dailyXpHistory, optional dailyChallenge* status fields, and arcade high scores."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server creation timestamp."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server last-modified timestamp."
        }
      },
      "required": [
        "uid",
        "reviewedServices",
        "completedScenarios",
        "perfectScenarios",
        "claimedAchievements",
        "flashcardConfidence",
        "flashcardSrs",
        "quizSrs",
        "arcade",
        "createdAt",
        "updatedAt"
      ]
    },
    "QuizAttempt": {
      "title": "Quiz Attempt Record",
      "description": "Immutable record of a completed CLF-C02 quiz, mock exam, SRS session, or arcade sprint.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "Owning Firebase Auth UID."
        },
        "mode": {
          "type": "string",
          "enum": ["drill", "practice", "mock", "srs", "blitz"],
          "description": "Quiz or arcade mode."
        },
        "domainFilter": {
          "type": "string",
          "enum": ["all", "domain-1", "domain-2", "domain-3", "domain-4"],
          "description": "Target CLF-C02 exam domain filter."
        },
        "correctCount": {
          "type": "integer",
          "description": "Number of correct answers (0 to 500)."
        },
        "totalCount": {
          "type": "integer",
          "description": "Total questions in attempt (1 to 500)."
        },
        "scaledScore": {
          "type": "integer",
          "description": "CLF-C02 scaled score (100 to 1000)."
        },
        "dateIso": {
          "type": "string",
          "minLength": 10,
          "maxLength": 40,
          "description": "Client ISO timestamp for display sorting."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp when attempt was persisted."
        }
      },
      "required": [
        "uid",
        "mode",
        "domainFilter",
        "correctCount",
        "totalCount",
        "scaledScore",
        "dateIso",
        "createdAt"
      ]
    },
    "CoachSession": {
      "title": "Study Coach Session",
      "description": "Cloud-synced Study Coach briefing, active Study Plan checklist, progressive hint state, and Ask Coach conversation history.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "Owning Firebase Auth UID."
        },
        "sessionId": {
          "type": "string",
          "minLength": 16,
          "maxLength": 64,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "Coach session identifier."
        },
        "briefing": {
          "type": "object",
          "description": "Latest personalized Study Coach briefing and recommended study plan."
        },
        "hintData": {
          "type": "object",
          "description": "Latest contextual progressive Socratic hint."
        },
        "hintContextKey": {
          "type": "string",
          "maxLength": 200,
          "description": "Context identifier for the active hint."
        },
        "chatMessages": {
          "type": "array",
          "description": "Bounded Ask Coach message history (max 40)."
        },
        "completedPlanSteps": {
          "type": "array",
          "description": "Checked-off Recommended Session Queue step keys (max 12)."
        },
        "updatedAtIso": {
          "type": "string",
          "minLength": 10,
          "maxLength": 40,
          "description": "ISO timestamp of last coach session mutation."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server creation timestamp."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server last-modified timestamp."
        }
      },
      "required": [
        "uid",
        "sessionId",
        "hintContextKey",
        "chatMessages",
        "completedPlanSteps",
        "updatedAtIso",
        "createdAt",
        "updatedAt"
      ]
    },
    "ServiceAudio": {
      "title": "Service Guide Audio Record",
      "description": "Persisted ElevenLabs synthesized audio URL, cache key, voice metadata, and spoken script for an AWS service guide.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "Owning Firebase Auth UID."
        },
        "serviceId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "AWS service guide identifier matching document ID."
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 140,
          "description": "AWS service title."
        },
        "audioUrl": {
          "type": "string",
          "minLength": 10,
          "maxLength": 512,
          "pattern": "^(/api/audio/stream/[a-f0-9]{16,64}|https://.+)$",
          "description": "Streamable audio URL for the synthesized ElevenLabs MP3."
        },
        "cacheKey": {
          "type": "string",
          "minLength": 16,
          "maxLength": 64,
          "pattern": "^[a-f0-9]+$",
          "description": "SQLite audio cache hash key."
        },
        "voiceKey": {
          "type": "string",
          "enum": ["rachel", "adam", "bella", "josh"],
          "description": "Selected ElevenLabs voice key."
        },
        "voiceLabel": {
          "type": "string",
          "minLength": 1,
          "maxLength": 40,
          "description": "Human-readable ElevenLabs voice label."
        },
        "scriptText": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1600,
          "description": "Spoken lesson script synthesized into audio."
        },
        "scriptProvider": {
          "type": "string",
          "enum": ["deepseek", "gemini", "curated"],
          "description": "Provider that authored the spoken script."
        },
        "audioProvider": {
          "type": "string",
          "enum": ["elevenlabs"],
          "description": "Audio synthesis provider."
        },
        "byteLength": {
          "type": "integer",
          "description": "MP3 file byte length (0 to 20000000)."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server creation timestamp."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server last-modified timestamp."
        }
      },
      "required": [
        "uid",
        "serviceId",
        "title",
        "audioUrl",
        "cacheKey",
        "voiceKey",
        "voiceLabel",
        "scriptText",
        "scriptProvider",
        "audioProvider",
        "byteLength",
        "createdAt",
        "updatedAt"
      ]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/UserRoot" },
      "description": "Root ownership anchor for a verified user (non-PII)."
    },
    "/users/{userId}/private/{docId}": {
      "schema": { "$ref": "#/entities/UserPrivateProfile" },
      "description": "Private PII profile document (`profile`) strictly restricted to owning user."
    },
    "/users/{userId}/progress/{docId}": {
      "schema": { "$ref": "#/entities/UserStudyProgress" },
      "description": "Synchronized CLF-C02 study progress state (`current`) belonging to the user."
    },
    "/users/{userId}/quizAttempts/{attemptId}": {
      "schema": { "$ref": "#/entities/QuizAttempt" },
      "description": "Per-user quiz and arcade attempt history records."
    },
    "/users/{userId}/coach/{docId}": {
      "schema": { "$ref": "#/entities/CoachSession" },
      "description": "Cross-device cloud-synced Study Coach session (`current`) belonging to the user."
    },
    "/users/{userId}/serviceAudio/{serviceId}": {
      "schema": { "$ref": "#/entities/ServiceAudio" },
      "description": "Per-user synthesized ElevenLabs service guide audio URLs and metadata."
    }
  }
}
